{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "aissa-com",
          "appId": "1:524291198943:android:67e7c80b887e18c587be6a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "aissa-com",
          "configurations": {
            "android": "1:524291198943:android:67e7c80b887e18c587be6a",
            "ios": "1:524291198943:ios:1b624608b36c6ae587be6a",
            "macos": "1:524291198943:ios:1b624608b36c6ae587be6a",
            "web": "1:524291198943:web:6fd064085452f11887be6a",
            "windows": "1:524291198943:web:3a348e53c6b46fb487be6a"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}